{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run QT's Dex",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/bot.py",
      "console": "integratedTerminal",
      "envFile": "${workspaceFolder}/.env",
      "justMyCode": true
    },
    {
      "name": "Clear Commands (run once to fix duplicates)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/clear_commands.py",
      "console": "integratedTerminal",
      "envFile": "${workspaceFolder}/.env",
      "justMyCode": true
    }
  ]
}
